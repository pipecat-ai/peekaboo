# Peekaboo keeps its LLM API keys in the login keychain, entered in
# Settings; nothing here is read by the app.
#
# The cloud speech services are a development option (`--tts cartesia`,
# `--stt deepgram`) and take their keys from the shell's environment, and
# `uv run src/bot.py -t daily` (the remote demo) reads this file.
DEEPGRAM_API_KEY=your_deepgram_api_key_here
CARTESIA_API_KEY=your_cartesia_key_here
CARTESIA_VOICE_ID=your_cartesia_voice_id_here
DAILY_API_KEY=your_daily_api_key_here
DAILY_SAMPLE_ROOM_URL=your_daily_sample_room_url_here
