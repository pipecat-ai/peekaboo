# Keys can also be entered in Settings, which keeps them in the keychain.
ANTHROPIC_API_KEY=your_anthropic_key_here

# Speech, unless the app runs with --local-speech (Moonshine and Kokoro on
# the machine, no keys). CARTESIA_VOICE_ID is optional.
# Only with --stt deepgram; Moonshine on the machine hears the conversation by default.
# Only if the OpenAI provider is chosen in Settings.
OPENAI_API_KEY=your_openai_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
CARTESIA_API_KEY=your_cartesia_key_here
CARTESIA_VOICE_ID=your_cartesia_voice_id_here

# Only for `uv run src/bot.py -t daily`, the remote demo.
DAILY_API_KEY=your_daily_api_key_here
DAILY_SAMPLE_ROOM_URL=your_daily_sample_room_url_here
